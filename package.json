{
    "private": true,
    "workspaces": ["packages/*", "apps/*"],
    "scripts": {
        "check": "bun run --cwd packages/annotator check",
        "build": "bun run --cwd packages/annotator build",
        "test": "bun run --cwd packages/annotator test",
        "mac:build": "bun run --cwd apps/mac build",
        "mac:test": "bun run --cwd apps/mac test"
    }
}
