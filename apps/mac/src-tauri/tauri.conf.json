{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Annotator",
  "version": "0.1.0",
  "identifier": "com.nckrtl.annotator",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "menu",
        "title": "Annotator",
        "width": 360,
        "height": 480,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "resizable": false,
        "focus": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "transparent": true,
        "backgroundColor": "#00000000",
        "windowEffects": { "effects": ["popover"], "state": "active", "radius": 16 }
      },
      {
        "label": "comment",
        "title": "Annotator comment",
        "width": 380,
        "height": 200,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "resizable": false,
        "focus": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "transparent": true,
        "backgroundColor": "#00000000",
        "windowEffects": { "effects": ["popover"], "state": "active", "radius": 16 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": { "binaries/annotator-native": "annotator-native" },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"]
  }
}
